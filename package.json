    "autoprefixer": "^10.5.2",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
